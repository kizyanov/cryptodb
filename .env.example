# Параметры подключения к PostgreSQL.
# Используются и клиентами (psql и т. п.), и docker compose — для инициализации сервера.
# Скопируйте в `.env` и заполните своими значениями (файл `.env` в git не коммитится).

# Образ PostgreSQL. Вариант *-alpine заметно легче — важно при 1 ГБ RAM и 10 ГБ диска.
# Можно сменить версию, например: postgres:17-alpine
POSTGRES_IMAGE=postgres:18-alpine

PGHOST=localhost
PGPORT=5432
PGDATABASE=cryptodb
PGUSER=cryptodb
# Обязательно смените на надёжный пароль (сгенерировать: openssl rand -hex 16)!
PGPASSWORD=changeme

# ── Выгрузка на домашнюю копию (scripts/backup-push.sh) ─────────────
# ssh-цель домашней машины (дом доступен из интернета; основная машина
# наружу порты не открывает — соединение инициирует только она сама).
BACKUP_HOME_HOST=user@home.example.com
BACKUP_HOME_PORT=22
# Каталог на доме для дампа; должен существовать: mkdir -p /srv/cryptodb/backup
BACKUP_HOME_DIR=/srv/cryptodb/backup
# Каталог на доме, где лежит docker-compose.yml с сервисом db
BACKUP_HOME_PROJECT_DIR=/srv/cryptodb
# Путь к ssh-ключу для -i; пусто — стандартный ~/.ssh/id_* или ssh-agent
BACKUP_SSH_KEY=
# 1 — сразу восстанавливать дамп на домашней БД; 0 — только выгрузить файл
BACKUP_HOME_RESTORE=1
